# ---------------------------------------------------------------------------
# Wardogs VOIP - server configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# HTTP/WS port the control server listens on
PORT=4000
# Public base URL of this server (used to build the Discord OAuth redirect URI)
# Local dev: http://localhost:4000 — production: the public address
PUBLIC_URL=https://voip.alesza.eu

# --- Discord OAuth -------------------------------------------------------
# https://discord.com/developers/applications -> OAuth2
# Add redirect URI: <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: only members of this guild may sign in (leave empty to allow anyone)
DISCORD_REQUIRED_GUILD_ID=

# --- Session signing -----------------------------------------------------
# Random 32+ char string: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- LiveKit -------------------------------------------------------------
# URL the *desktop clients* connect to (ws:// for local dev, wss:// in prod).
# This is handed to clients at runtime, so it is NOT baked into the installer.
#
# It must resolve straight to the SFU, not through a Cloudflare/CDN proxy:
# WebRTC media is UDP and an HTTP proxy cannot carry it. Give the SFU its own
# DNS-only (grey cloud) record, e.g. wss://sfu.alesza.eu, and open UDP
# 50000-50100 plus TCP 7881 on that host.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# Deep link the OAuth flow hands the session token back to
DESKTOP_PROTOCOL=wardogs-voip

# --- Desktop build -------------------------------------------------------
# Baked into the installer so players never have to type an address.
# MUST be the public address of this server before you hand out a build.
WARDOGS_SERVER_URL=https://voip.alesza.eu
