{
  "name": "@wardogs/desktop",
  "version": "0.4.0",
  "productName": "Wardogs VOIP",
  "private": true,
  "description": "Platoon-style VOIP pro Wardogs - squad kanaly a velitelsky kanal",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "publish": "electron-vite build && electron-builder --win --publish always",
    "dist:all": "electron-vite build && electron-builder -mwl --publish never",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "//": "Only true native modules belong in dependencies - electron-vite externalises those and electron-builder ships them unpacked. Everything else is bundled from devDependencies.",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@wardogs/shared": "*",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "livekit-client": "^2.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.3"
  },
  "author": {
    "name": "ArcadeBulls",
    "email": "info@arcadebulls.cz"
  }
}
